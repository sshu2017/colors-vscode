{
  "name": "window-colors-replica",
  "displayName": "Window Colors Replica",
  "description": "Gives each workspace window a unique color in the title bar and activity bar, derived from the folder path.",
  "version": "0.0.6",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Window Colors",
      "properties": {
        "windowColors.theme": {
          "type": "string",
          "default": "dark",
          "enum": [
            "dark",
            "light",
            "revert"
          ],
          "description": "Controls the color shades to blend with dark or light themes. Windows are only colored when a workspace folder is open; select 'revert' and reload to remove the color from the current workspace."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "overrides": {
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.19.0",
    "typescript": "^5.3.0"
  }
}
